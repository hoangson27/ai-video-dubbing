{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AI Video Dubbing",
  "version": "0.1.0",
  "identifier": "com.aivideodubbing.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Video Dubbing",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' http://dubbing-media.localhost dubbing-media:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' http://dubbing-media.localhost dubbing-media:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../engine/dubbing/*.py": "engine/dubbing/",
      "../engine/requirements.txt": "engine/requirements.txt",
      "../scripts/setup-deps.ps1": "scripts/setup-deps.ps1",
      "../scripts/check-deps.ps1": "scripts/check-deps.ps1",
      "../scripts/dependency-inventory.ps1": "scripts/dependency-inventory.ps1",
      "../scripts/dev-profile.ps1": "scripts/dev-profile.ps1",
      "../scripts/install-deps.ps1": "scripts/install-deps.ps1",
      "../README.md": "README.md",
      "../docs/testing.md": "docs/testing.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": false
      }
    }
  }
}
