{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local media and engine commands for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-pick-video",
    "allow-pick-directory",
    "allow-media-url",
    "allow-engine-request",
    "allow-cancel-engine"
  ]
}
